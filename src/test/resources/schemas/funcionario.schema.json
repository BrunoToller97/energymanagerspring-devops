{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "nome",
    "cargo",
    "salario",
    "ativo",
    "setorId",
    "nomeSetor"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "cargo": {
      "type": "string"
    },
    "salario": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ativo": {
      "type": "string",
      "enum": ["S", "N"]
    },
    "setorId": {
      "type": "integer",
      "minimum": 1
    },
    "nomeSetor": {
      "type": "string"
    }
  },
  "additionalProperties": false
}