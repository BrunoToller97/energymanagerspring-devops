{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "nome",
    "cargo",
    "salario",
    "ativo",
    "setor"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "nome": {
      "type": "string"
    },
    "cargo": {
      "type": "string"
    },
    "salario": {
      "type": "number"
    },
    "ativo": {
      "type": "string",
      "enum": ["S", "N"]
    },
    "setor": {
      "type": "object",
      "required": ["id", "nome", "metaReducaoPercentual", "responsavel"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "nome": {
          "type": "string"
        },
        "metaReducaoPercentual": {
          "type": "number"
        },
        "responsavel": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}