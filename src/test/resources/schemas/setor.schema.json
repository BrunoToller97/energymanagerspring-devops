{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "nome",
    "metaReducaoPercentual",
    "responsavel"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "metaReducaoPercentual": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "responsavel": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}