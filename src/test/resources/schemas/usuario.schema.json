{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["usuarioId", "nome", "email", "role"],
  "properties": {
    "usuarioId": {
      "type": "integer",
      "minimum": 1
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "type": "string",
      "enum": ["ADMIN", "USER"]
    }
  },
  "additionalProperties": false
}